<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Compresión. Es la mitad del peso de la portada y no cuesta nada: el HTML
# baja de 79 a 10 KB, el CSS de 56 a 10 y el JSON de vehículos de 23 a 4,5.
# Las imágenes ya vienen en WebP, así que comprimirlas otra vez sólo gasta CPU.
# Brotli si el hosting lo trae: comprime entre un 15 y un 20 % mejor que gzip
# en texto, y el sitemap de productos son 4,9 MB de XML que Googlebot vuelve a
# pedir entero cada vez. Va ANTES de deflate porque el navegador que entiende
# los dos prefiere este; si el modulo no esta, Apache ignora el bloque y queda
# gzip, que es lo que hay hoy.
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
    AddOutputFilterByType BROTLI_COMPRESS application/xml application/rss+xml
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Caducidad de los estáticos.
#
# La directiva `Header` NO la aporta `mod_expires`, la aporta `mod_headers`.
# Cuando estaba dentro del bloque de expires, si el hosting tenía uno y no
# el otro, Apache abortaba con «Invalid command 'Header'». Ahora cada
# directiva vive dentro del módulo que la define.
<IfModule mod_headers.c>
    # Los assets de Vite llevan el hash del contenido en el nombre
    # (app-BZibRJkF.css), así que un cambio genera un nombre nuevo: se pueden
    # guardar un año sin riesgo de servir una versión vieja.
    <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On

    # Las imágenes no llevan hash: si el cliente sube un banner nuevo con el
    # mismo nombre, un mes es lo que puede tardar en verse. Suficiente.
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"

    # E5 del plan · Los videos también necesitan caducar; sin esto se
    # revalidan en cada visita y arrastrar la barra de reproducción los
    # descarga entero de nuevo.
    ExpiresByType video/mp4 "access plus 30 days"

    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Cabeceras de seguridad básicas (B4 del hallazgo del auditor).
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), camera=(), microphone=()"
    # Evita clickjacking sobre el formulario de cotización.
    Header set X-Frame-Options "SAMEORIGIN"

    # Content-Security-Policy.
    #
    # `'unsafe-eval'` NO es opcional aquí, y conviene entender por qué antes de
    # quitarlo: Alpine evalúa las expresiones de `x-data`, `@click` y `x-show`
    # con `new Function(...)`, que la política gobierna con `script-src
    # 'unsafe-eval'`. Sin él, en el servidor real —donde Apache SÍ lee este
    # archivo, a diferencia de `artisan serve`— muere de golpe todo lo
    # interactivo: el selector marca→modelo→cilindraje→año, el menú móvil, las
    # sugerencias del buscador, el contador del carrito y el mapa de la
    # portada, que además se queda invisible para siempre por su `x-cloak`.
    # Trece vistas dependen de esto.
    #
    # `'unsafe-inline'` lo necesitan el telón de entrada —que decide antes del
    # primer pintado— y el campo «HTML extra en el head» del panel, que existe
    # justo para pegar un píxel de Meta.
    #
    # Y hay que decirlo sin adornos: con esas dos permisiones, esta política NO
    # protege contra un script inyectado. Lo que sí hace, y no es poco, es
    # cerrar de dónde puede venir TODO lo demás —imágenes, marcos, formularios,
    # conexiones, `object-src 'none'`—, de modo que un archivo subido o un
    # `head_extra` mal pegado no puedan sacar datos a otro dominio ni enmarcar
    # el sitio. Endurecer `script-src` de verdad pide `@alpinejs/csp` y nonces
    # por petición: es un trabajo aparte, no un ajuste de esta línea.
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; media-src 'self'; frame-src https://www.google.com https://maps.google.com; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'"
</IfModule>
